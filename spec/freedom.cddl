; Freedom Protocol canonical object schema
; Status: normative schema draft
;
; Field names and object shapes in this file are the single source of truth for
; objects that are frozen enough to be referenced by normative documentation.
; Objects not present here are not frozen for public interoperability.
; Security semantics: docs/SECURITY_INVARIANTS.md and subsystem docs.
; Encoding target: deterministic CBOR with frozen positive/negative vectors.
; Cryptographic domains: spec/crypto-domains.txt.

uint64 = uint
bytes16 = bstr .size 16
bytes32 = bstr .size 32
network-id = tstr

; ---- User root / device authorization --------------------------------------------------------

root-control-state = {
  version: uint,
  root_control_commitment: bytes32,
  root_epoch: uint64,
  root_public_key: bstr,
  root_commitment: bytes32,
  ? recovery_policy_commitment: bytes32,
  ? pending_compromise_recovery_hash: bytes32,
  updated_at_height: uint64
}

device-authorization-delegation = {
  version: uint,
  network_id: network-id,
  root_epoch: uint64,
  authorization_public_key: bstr,
  authorization_epoch: uint64,
  capabilities: [* tstr],
  valid_from_height: uint64,
  expires_after_height: uint64,
  root_recovery_signature: bstr
}

device-certificate = {
  version: uint,
  network_id: network-id,
  root_identity_proof: bstr,
  root_epoch: uint64,
  authorization_epoch: uint64,
  device_record_commitment: bytes32,
  device_public_key: bstr,
  key_epoch: uint64,
  protocol_version: uint,
  capabilities: [* tstr],
  issued_at_height: uint64,
  expires_after_height: uint64,
  certificate_id: bytes32,
  authorization_signature: bstr
}

device-record = {
  version: uint,
  device_record_commitment: bytes32,
  device_public_key: bstr,
  device_control_public_key: bstr,
  key_epoch: uint64,
  status: "ACTIVE" / "REVOKED",
  protocol_version: uint,
  updated_at_height: uint64
}

device-revocation-record = {
  version: uint,
  device_record_commitment: bytes32,
  revoked_key_epoch_floor: uint64,
  revocation_epoch: uint64,
  effective_height: uint64,
  reason_code: uint,
  authorization_kind: "DEVICE_CONTROL" / "RECOVERY_OR_SUCCESSOR",
  authorization_proof: bstr
}

authorization-revocation-record = {
  version: uint,
  authorization_key_commitment: bytes32,
  revoked_authorization_epoch_floor: uint64,
  revocation_epoch: uint64,
  effective_height: uint64,
  recovery_or_successor_proof: bstr
}

user-recovery-policy = {
  version: uint,
  root_control_commitment: bytes32,
  recovery_policy_epoch: uint64,
  recovery_key_commitments: [2* bstr],
  threshold: uint,
  recovery_delay_blocks: uint64,
  policy_commitment: bytes32
}

; V1 recovery policy is sticky. NORMAL rotation inherits current policy commitment.
; COMPROMISE_RECOVERY requires the precommitted independent recovery quorum.
user-root-rotation = {
  version: uint,
  root_control_commitment: bytes32,
  current_root_epoch: uint64,
  current_root_commitment: bytes32,
  new_root_public_key: bstr,
  new_root_commitment: bytes32,
  recovery_policy_epoch: uint64,
  recovery_policy_commitment: bytes32,
  rotation_mode: "NORMAL" / "COMPROMISE_RECOVERY",
  requested_at_height: uint64,
  activation_height: uint64,
  old_root_continuity_proof: bstr / null,
  recovery_quorum_proof: bstr / null
}

encrypted-recovery-bundle = {
  version: uint,
  kdf_id: tstr,
  kdf_params: bstr,
  salt: bstr,
  nonce: bstr,
  root_recovery_secret_ciphertext: bstr,
  ? recovery_state_key_ciphertext: bstr,
  root_identity_fingerprint: bytes32,
  bundle_integrity: bstr
}

; ---- Pairwise contact / rendezvous -----------------------------------------------------------

freedom-contact = {
  version: uint,
  network_id: network-id,
  root_identity_proof: bstr,
  contact_capability: bstr,
  ? bootstrap_device_certificate: device-certificate,
  ? bootstrap_route_hints: [* route-candidate],
  ? expires_after_height: uint64
}

; PairRendezvousSecret derives a fresh write keypair off-chain per direction/epoch.
; The public slot itself is simply a domain-separated hash of the derived public key,
; so the control plane can verify the slot binding without learning pair epoch/direction.
rendezvous-record = {
  version: uint,
  network_id: network-id,
  slot_id: bytes32,
  write_public_key: bstr,
  generation: uint64,
  issued_at_height: uint64,
  expires_after_height: uint64,
  ciphertext: bstr,
  write_signature: bstr
}

recovery-beacon = {
  version: uint,
  network_id: network-id,
  slot_id: bytes32,
  write_public_key: bstr,
  generation: uint64,
  issued_at_height: uint64,
  expires_after_height: uint64,
  recovery_nonce: bytes32,
  route_generation: uint64,
  state: "SEEKING_PATH" / "TRYING_ALTERNATIVE",
  ciphertext: bstr,
  write_signature: bstr
}

pairwise-recovery-bundle = {
  version: uint,
  bundle_id: bytes32,
  state_epoch: uint64,
  backup_generation: uint64,
  previous_bundle_hash: bytes32 / null,
  created_at_height: uint64,
  recovery_key_epoch: uint64,
  contacts_metadata_ciphertext: bstr,
  pairwise_state_ciphertext: bstr,
  state_commitment: bytes32,
  integrity: bstr
}

; Optional monotonic freshness anchor for rollback-detectable recovery after total device loss.
; The full pairwise bundle remains off-chain/on user-chosen untrusted storage.
pairwise-recovery-anchor = {
  version: uint,
  root_control_commitment: bytes32,
  anchor_epoch: uint64,
  latest_backup_generation: uint64,
  latest_bundle_hash: bytes32,
  latest_state_commitment: bytes32,
  recovery_key_epoch: uint64,
  updated_at_height: uint64,
  authorization_proof: bstr
}

; ---- Routing / relay / Shield ---------------------------------------------------------------

route-candidate = {
  transport: tstr,
  endpoint: tstr,
  candidate_type: tstr,
  priority: int,
  observed_at_height: uint64,
  expires_after_height: uint64
}

route-update = {
  version: uint,
  sequence: uint64,
  candidates: [* route-candidate],
  relay_candidates: [* relay-candidate],
  issued_at_height: uint64,
  expires_after_height: uint64
}

relay-descriptor = {
  version: uint,
  relay_public_key: bstr,
  relay_id: bytes32,
  relay_class: tstr,
  endpoint: tstr,
  transport: tstr,
  capabilities: [* tstr],
  ? self_declared_metadata: bstr,
  ? observed_metadata: bstr,
  ? provenance_attestations: [* provenance-attestation],
  expires_after_height: uint64,
  signature: bstr
}

provenance-attestation = {
  version: uint,
  issuer_id: bytes32,
  issuer_class: tstr,
  subject_relay_id: bytes32,
  claim_type: tstr,
  claim_value: bstr,
  observed_at_height: uint64,
  expires_after_height: uint64,
  signature: bstr
}

relay-candidate = {
  descriptor_hash: bytes32,
  ? capability_token: bstr,
  ? capacity_hint: uint64
}

relay-packet = {
  version: uint,
  packet_id: bytes32,
  next_hop_token: bstr,
  hop_limit: uint,
  expires_after_height: uint64,
  ciphertext: bstr
}

relay-contribution-proof = {
  version: uint,
  relay_commitment: bytes32,
  contribution_epoch: uint64,
  ? availability_commitment: bytes32,
  ? forwarding_commitment: bytes32,
  policy_version: uint,
  expires_after_height: uint64,
  attestations: [* bstr]
}

shield-hop-descriptor = {
  version: uint,
  relay_descriptor_hash: bytes32,
  hop_public_key: bstr,
  transport: tstr,
  ? provenance_attestations: [* provenance-attestation],
  expires_after_height: uint64
}

shield-circuit-descriptor = {
  version: uint,
  circuit_id: bytes32,
  circuit_epoch: uint64,
  hops: [2* shield-hop-descriptor],
  policy_hash: bytes32,
  expires_after_height: uint64
}

; ---- Handshake / session / rekey -------------------------------------------------------------

handshake-offer = {
  version: uint,
  network_id: network-id,
  supported_versions: [1* uint],
  supported_suites: [1* tstr],
  supported_transport_semantics: [1* ("RELIABLE_ORDERED_STREAM" / "UNRELIABLE_DATAGRAM")],
  certificate_hash: bytes32,
  key_epoch: uint64,
  ephemeral_public_key: bstr,
  nonce: bytes32
}

rekey-init = {
  version: uint,
  session_id: bytes32,
  current_epoch: uint64,
  next_epoch: uint64,
  initiator_ephemeral_public_key: bstr,
  nonce: bytes32,
  transcript_hash: bytes32
}

rekey-commit = {
  version: uint,
  session_id: bytes32,
  next_epoch: uint64,
  responder_ephemeral_public_key: bstr,
  init_hash: bytes32,
  transcript_hash: bytes32
}

rekey-ack = {
  version: uint,
  session_id: bytes32,
  next_epoch: uint64,
  commit_hash: bytes32,
  key_confirmation: bytes32
}

encrypted-control-frame = {
  version: uint,
  session_hint: bytes32,
  traffic_key_epoch: uint64,
  stream_sequence: uint64,
  ciphertext: bstr
}

encrypted-media-frame = {
  version: uint,
  session_hint: bytes32,
  media_stream_id: bytes32,
  media_key_epoch: uint64,
  packet_sequence: uint64,
  ciphertext: bstr
}

chat-message = {
  version: uint,
  message_id: bytes32,
  logical_sequence: uint64,
  sent_at_logical: uint64,
  body: bstr,
  ? reply_to: bytes32
}

message-ack = {
  version: uint,
  message_id: bytes32,
  ack_type: "RECEIVED" / "READ",
  logical_time: uint64
}

attachment-manifest = {
  version: uint,
  attachment_id: bytes32,
  media_type: tstr,
  plaintext_size: uint64,
  chunk_size: uint,
  chunk_hashes: [1* bytes32],
  integrity_root: bytes32
}

call-signal = {
  version: uint,
  call_id: bytes32,
  signal_type: "INVITE" / "ACCEPT" / "CANDIDATE" / "END",
  sequence: uint64,
  payload: bstr
}

; ---- Control-plane verification --------------------------------------------------------------

verified-control-plane-checkpoint = {
  version: uint,
  network_id: network-id,
  chain_adapter_id: tstr,
  finalized_height: uint64,
  finalized_block_hash: bytes32,
  state_root: bytes32,
  finalized_time: uint64,
  consensus_or_finality_proof: bstr,
  verifier_version: uint
}

bootstrap-freshness-floor = {
  minimum_checkpoint_height: uint64,
  ? minimum_checkpoint_hash: bytes32,
  minimum_signer_set_epoch: uint64,
  minimum_policy_epoch: uint64,
  issued_in_release_id: tstr
}

state-migration-proof = {
  version: uint,
  source_checkpoint_hash: bytes32,
  source_export_root: bytes32,
  migration_program_hash: bytes32,
  migration_input_commitment: bytes32,
  target_imported_state_root: bytes32,
  verification_artifact: bstr
}

chain-migration-manifest = {
  version: uint,
  from_adapter: tstr,
  to_adapter: tstr,
  from_final_checkpoint_hash: bytes32,
  state_migration_proof_hash: bytes32,
  new_network_anchor: bytes32,
  activation_epoch: uint64,
  activation_height: uint64,
  governance_signatures: [* bstr]
}

contract-upgrade-manifest = {
  version: uint,
  governance_epoch: uint64,
  current_code_hash: bytes32,
  new_code_hash: bytes32,
  migration_program_hash: bytes32,
  activation_height: uint64,
  rollback_floor: uint64,
  signatures: [* bstr]
}

; ---- Entitlement / payments -----------------------------------------------------------------

freedom-entitlement = {
  version: uint,
  entitlement_commitment: bytes32,
  tier: tstr,
  entitlement_epoch: uint64,
  ? max_devices_product_policy: uint,
  ? base_contact_slots_product_policy: uint,
  issued_at_height: uint64,
  ? expires_after_height: uint64,
  policy_version: uint,
  status: "ACTIVE" / "SUSPENDED" / "EXPIRED"
}

purchase-intent = {
  version: uint,
  purchase_ref_hash: bytes32,
  payment_binding_commitment: bytes32,
  product: tstr,
  amount_minor: uint64,
  currency_or_asset: tstr,
  provider: tstr,
  expires_after_height: uint64,
  status: tstr
}

payment-descriptor = {
  version: uint,
  provider: tstr,
  payment_target: tstr,
  supported_products: [* tstr],
  currencies_or_assets: [* tstr],
  config_version: uint64,
  ? expires_after_height: uint64,
  issuer_signature: bstr
}

payment-attestation = {
  version: uint,
  provider: tstr,
  provider_transaction_commitment: bytes32,
  purchase_ref_hash: bytes32,
  amount_minor: uint64,
  currency_or_asset: tstr,
  status: tstr,
  observed_at_height: uint64,
  worker_id: bytes32,
  signature: bstr
}

entitlement-voucher = {
  version: uint,
  voucher_commitment: bytes32,
  product: tstr,
  entitlement_delta: bstr,
  issued_at_height: uint64,
  expires_after_height: uint64,
  issuer_epoch: uint64,
  signature_or_blind_credential: bstr
}

entitlement-redemption = {
  version: uint,
  voucher_nullifier: bytes32,
  entitlement_commitment_or_proof: bstr,
  redemption_epoch: uint64,
  proof: bstr
}

; ---- Release / governance -------------------------------------------------------------------

freedom-release = {
  manifest_version: uint,
  release_id: tstr,
  version_code: uint64,
  version_name: tstr,
  package_id: tstr,
  artifact_sha256: bytes32,
  artifact_size: uint64,
  signing_cert_fingerprint: bytes32,
  ? signing_lineage_commitment: bytes32,
  min_supported_version: uint64,
  min_secure_version: uint64,
  criticality: tstr,
  release_locator_hash: bytes32,
  issued_at_height: uint64,
  signer_set_epoch: uint64,
  bootstrap_freshness_floor: bootstrap-freshness-floor,
  signatures: [* bstr]
}

freedom-release-locator = {
  locator_version: uint,
  release_id: tstr,
  release_nonce: bytes32,
  manifest_hash: bytes32,
  artifact_sha256: bytes32,
  package_id: tstr,
  version_code: uint64,
  channel: tstr,
  issued_at_height: uint64,
  ? expires_after_height: uint64,
  signer_set_epoch: uint64,
  signatures: [* bstr]
}

release-status = {
  version: uint,
  release_id: tstr,
  artifact_sha256: bytes32,
  status: "ACTIVE" / "DEPRECATED" / "REVOKED",
  status_epoch: uint64,
  min_secure_version: uint64,
  policy_epoch: uint64,
  reason_hash: bytes32 / null,
  remediation_release: tstr / null,
  issued_at_height: uint64,
  signer_set_epoch: uint64,
  signatures: [* bstr]
}

security-policy = {
  version: uint,
  policy_epoch: uint64,
  latest_version: uint64,
  min_supported_version: uint64,
  min_secure_version: uint64,
  vulnerable_versions: [* uint64],
  disabled_features: [* tstr],
  severity: tstr,
  reason_hash: bytes32,
  remediation_release: tstr,
  issued_at_height: uint64,
  ? expires_after_height: uint64,
  signer_set_epoch: uint64,
  signatures: [* bstr]
}

emergency-bulletin = {
  version: uint,
  bulletin_id: bytes32,
  severity: tstr,
  issued_at_height: uint64,
  expires_after_height: uint64,
  ? geographic_scope: bstr,
  ? topic: tstr,
  ? min_app_version: uint64,
  ? min_protocol_version: uint,
  payload_hash: bytes32,
  issuer_set_epoch: uint64,
  signatures: [* bstr]
}

signer-set = {
  version: uint,
  signer_set_epoch: uint64,
  role: tstr,
  public_keys: [1* bstr],
  threshold: uint,
  valid_from_height: uint64,
  ? expires_after_height: uint64,
  ? previous_set_commitment: bytes32,
  ? governance_recovery_set_commitment: bytes32
}

signer-set-transition = {
  version: uint,
  role: tstr,
  previous_epoch: uint64,
  next_epoch: uint64,
  previous_set_commitment: bytes32,
  next_set_commitment: bytes32,
  activation_height: uint64,
  previous_set_threshold_signatures: [* bstr],
  next_set_acceptance_signatures: [* bstr]
}

governance-recovery-manifest = {
  version: uint,
  role: tstr,
  failed_signer_set_epoch: uint64,
  recovery_set_commitment: bytes32,
  next_set_commitment: bytes32,
  activation_height: uint64,
  recovery_timelock_blocks: uint64,
  recovery_threshold_signatures: [* bstr]
}

bootstrap-trust-anchor = {
  version: uint,
  verifier_policy_version: uint,
  expected_package_id: tstr,
  release_signer_set_root_commitment: bytes32,
  ? governance_recovery_set_commitment: bytes32,
  android_signing_root_or_lineage_anchor: bytes32,
  minimum_manifest_version: uint,
  accepted_contract_or_controlplane_anchor: bytes32,
  bootstrap_freshness_floor: bootstrap-freshness-floor
}

peer-transfer-capability = {
  version: uint,
  transfer_nonce: bytes32,
  release_id: tstr,
  artifact_sha256: bytes32,
  source_endpoint: tstr,
  expires_after_height: uint64,
  ? max_downloads: uint
}

freedom-install-descriptor = {
  version: uint,
  channel: tstr,
  package_id: tstr,
  release_id: tstr,
  release_locator_hash: bytes32,
  release_manifest_hash: bytes32,
  source_hints: [* tstr],
  ? peer_transfer_capability: peer-transfer-capability,
  expires_after_height: uint64
}
