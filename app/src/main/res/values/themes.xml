        <item name="colorSurface">@color/freedom_surface</item>
        <item name="colorSurfaceVariant">@color/freedom_surface_variant</item>
        <item name="colorOnSurface">@color/freedom_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/freedom_on_surface_variant</item>
        <item name="colorOutline">@color/freedom_outline</item>
        <item name="colorError">@color/freedom_error</item>
        <item name="android:fontFamily">sans</item>
